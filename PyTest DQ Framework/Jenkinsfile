pipeline {
    agent any
    environment {
        POSTGRES_SECRET = credentials('jenkins-postgres-credentials')
    }
    stages {
        stage('Install System Packages') {
            steps {
                sh 'apt-get update'
                sh 'apt-get install -y libpq-dev python3 python3-pip python3-venv'
            }
        }
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/volha-hancharuk/dqe-automation'
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                    '''
                }
            }
        }
        stage('Run DQ Tests') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        . venv/bin/activate
                        pytest tests -m "parquet_data" \
                            --db_host="postgres" \
                            --db_port="5432" \
                            --db_name="mydatabase" \
                            --db_user="$POSTGRES_SECRET_USR" \
                            --db_password="$POSTGRES_SECRET_PSW" \
                            --html=html_report/report.html --self-contained-html
                    '''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**', allowEmptyArchive: true
            publishHTML(target: [
            allowMissing: false,
            keepAll: true,
            reportDir: 'PyTest DQ Framework/html_report',
            reportFiles: 'report.html',
            reportName: 'HTML Test Report'
])
        }
    }
}
